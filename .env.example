# Copy to .env and adjust. Never commit .env.

# Postgres — matches docker-compose.yml
DATABASE_URL="postgresql://govcms:govcms@localhost:5434/govcms?schema=public"

# Core API
PORT=4001
NODE_ENV=development

# Auth — generate a strong secret for anything beyond local dev:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET="dev-only-change-me"
JWT_EXPIRES_IN="1d"
